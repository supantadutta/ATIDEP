# Copy to .env and fill in. Never commit .env.
ATIDEP_API_KEY=change-me

# LLM provider: ollama (default, local, no key) or cloud (explicit opt-in).
ATIDEP_LLM_PROVIDER=ollama
ATIDEP_LLM_MODEL=
ATIDEP_LLM_URL=http://127.0.0.1:11434

# Hosted model (only with ATIDEP_LLM_PROVIDER=cloud). Refused unless config/policies.yaml has
# llm.cloud_enabled: true and a positive daily_cost_limit, and the price entry below is a PRICED
# entry of config/price_register.yaml (the cap is in that entry's currency). Never commit the key.
ATIDEP_CLOUD_URL=
ATIDEP_CLOUD_MODEL=
ATIDEP_CLOUD_API_STYLE=openai
ATIDEP_CLOUD_KEY=
ATIDEP_CLOUD_PRICE_ENTRY=
ATIDEP_CLOUD_CA_BUNDLE=
ATIDEP_REPLAY_STORE=data/llm_replay.jsonl

# Wazuh lab manager (least-privilege RBAC user; see blueprint §20.5)
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_API_CA_BUNDLE=
