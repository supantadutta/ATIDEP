# Copy to .env and fill in. Never commit .env.
ATIDEP_API_KEY=change-me

# LLM provider (one of: ollama, anthropic). Local Ollama needs no key.
ATIDEP_LLM_PROVIDER=ollama
ATIDEP_LLM_MODEL=
ATIDEP_LLM_API_KEY=

# Wazuh lab manager (least-privilege RBAC user; see blueprint §20.5)
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_API_CA_BUNDLE=
